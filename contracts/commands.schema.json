        "maxLength": 100000,
        "minLength": 1,
        "pattern": "\\S",
        "title": "Result",
        "type": "string"
      }
    },
    "required": [
      "expected_version",
      "result"
    ],
    "title": "Complete",
    "type": "object"
  },
  "task.release": {
    "additionalProperties": false,
