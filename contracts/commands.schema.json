  "link.create": {
    "additionalProperties": false,
    "description": "One edge: artifact attached_to challenge/task/finding, or finding chains.\n\nleads_to: finding/task -> finding/flag/task; supports/supersedes: finding -> finding;\nrefutes: finding -> finding/flag (a refuted hypothesis changes its status).",
