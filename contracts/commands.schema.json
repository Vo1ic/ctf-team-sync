        "type": "integer"
      }
    },
    "required": [
      "expected_version"
    ],
    "title": "Lease",
    "type": "object"
  },
  "task.complete": {
    "additionalProperties": false,
    "properties": {
      "expected_version": {
        "minimum": 1,
        "title": "Expected Version",
        "type": "integer"
      },
