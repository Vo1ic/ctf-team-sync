{
  "challenge.create": {
    "additionalProperties": false,
    "properties": {
      "title": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "\\S",
        "title": "Title",
        "type": "string"
      },
      "description": {
        "default": "",
        "maxLength": 100000,
        "title": "Description",
        "type": "string"
      },
      "category": {
        "anyOf": [
          {
            "maxLength": 100,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Category"
      }
    },
    "required": [
      "title"
    ],
    "title": "ChallengeCreate",
    "type": "object"
  },
  "task.create": {
    "additionalProperties": false,
    "properties": {
      "title": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "\\S",
        "title": "Title",
        "type": "string"
      },
      "description": {
        "default": "",
        "maxLength": 100000,
        "title": "Description",
        "type": "string"
      },
      "category": {
        "default": null,
        "title": "Category",
        "type": "null"
      },
      "challenge_id": {
        "anyOf": [
          {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Challenge Id"
      }
    },
    "required": [
      "title"
    ],
    "title": "TaskCreate",
    "type": "object"
  },
  "task.claim": {
    "additionalProperties": false,
    "properties": {
      "expected_version": {
        "minimum": 1,
        "title": "Expected Version",
        "type": "integer"
      },
      "lease_seconds": {
        "default": 300,
        "maximum": 3600,
        "minimum": 10,
        "title": "Lease Seconds",
        "type": "integer"
      }
    },
    "required": [
      "expected_version"
    ],
    "title": "Lease",
    "type": "object"
  },
  "task.renew": {
    "additionalProperties": false,
