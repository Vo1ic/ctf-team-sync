        "maxLength": 100000,
        "minLength": 1,
        "pattern": "\\S",
        "title": "Body",
        "type": "string"
      },
      "kind": {
        "default": "observation",
        "enum": [
          "observation",
          "hypothesis",
          "result",
          "failed_attempt"
        ],
        "title": "Kind",
        "type": "string"
      },
      "evidence": {
        "maxLength": 100000,
        "minLength": 1,
        "pattern": "\\S",
        "title": "Evidence",
        "type": "string"
      },
      "challenge_id": {
        "anyOf": [
          {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Challenge Id"
      },
      "task_id": {
        "anyOf": [
          {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Task Id"
      }
    },
    "required": [
      "title",
      "body",
      "evidence"
    ],
    "title": "FindingCreate",
    "type": "object"
  },
  "flag.create": {
    "additionalProperties": false,
    "properties": {
      "value": {
        "maxLength": 4096,
        "minLength": 1,
        "pattern": "\\S",
        "title": "Value",
        "type": "string"
      },
      "challenge_id": {
        "anyOf": [
          {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
