{
  "resource.update": {
    "additionalProperties": false,
    "properties": {
      "collection": {
        "enum": [
          "projects",
          "actors",
          "challenges",
          "tasks",
          "findings",
          "flags",
          "verifications",
          "submissions",
          "artifacts",
          "messages",
          "activities"
        ],
        "title": "Collection",
        "type": "string"
      },
      "expected_version": {
        "minimum": 1,
        "title": "Expected Version",
        "type": "integer"
      },
      "changes": {
        "additionalProperties": true,
        "maxProperties": 20,
        "minProperties": 1,
        "title": "Changes",
        "type": "object"
      },
      "reason": {
        "default": "",
        "maxLength": 10000,
        "title": "Reason",
        "type": "string"
      },
      "force": {
        "default": false,
        "title": "Force",
        "type": "boolean"
      }
    },
    "required": [
      "collection",
      "expected_version",
      "changes"
    ],
    "title": "ResourceEdit",
    "type": "object",
    "examples": [
      {
        "operation": "resource.update",
        "resource_id": "00000000-0000-4000-8000-000000000001",
        "arguments": {
          "collection": "tasks",
          "expected_version": 3,
          "changes": {
            "priority": "urgent"
          },
          "reason": "blocks two other tasks"
        },
        "idempotency_key": "edit-1"
      }
    ]
  },
