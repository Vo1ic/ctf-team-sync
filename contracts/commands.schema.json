        "title": "Target Id",
        "type": "string"
      },
      "relation": {
        "enum": [
          "attached_to",
          "leads_to",
          "supports",
          "refutes",
          "supersedes"
        ],
        "title": "Relation",
        "type": "string"
      },
      "note": {
        "default": "",
        "maxLength": 500,
        "title": "Note",
        "type": "string"
      }
    },
    "required": [
      "source_type",
      "source_id",
      "target_type",
      "target_id",
      "relation"
    ],
    "title": "LinkCreate",
    "type": "object"
  },
