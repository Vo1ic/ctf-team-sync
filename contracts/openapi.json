  "components": {
    "schemas": {
      "ActorCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Name"
          },
          "kind": {
            "type": "string",
            "enum": [
              "human",
              "agent"
            ],
            "title": "Kind",
            "default": "agent"
          },
          "role": {
            "$ref": "#/components/schemas/Role",
            "default": "worker"
          },
          "owner_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Owner Id"
          },
          "capabilities": {
            "items": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1,
              "pattern": "\\S"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Capabilities"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "ActorCreate"
      },
      "AgentAction": {
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "challenge.create",
              "task.create",
              "task.claim",
              "task.renew",
              "task.complete",
              "finding.create",
              "flag.create",
              "flag.verify",
              "submission.create",
              "message.send",
              "message.ack"
            ],
            "title": "Operation"
          },
          "resource_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resource Id"
          },
          "arguments": {
            "additionalProperties": true,
            "type": "object",
            "title": "Arguments"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Idempotency Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "operation",
          "idempotency_key"
        ],
        "title": "AgentAction",
        "description": "Transport-independent MCP command envelope."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ProjectCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Name"
          },
          "owner_name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Owner Name"
          },
          "profile": {
            "type": "string",
            "enum": [
              "jeopardy",
              "attack_defense",
              "custom"
            ],
            "title": "Profile",
            "default": "jeopardy"
          },
          "capabilities": {
            "additionalProperties": {
              "type": "boolean"
            },
            "type": "object",
            "title": "Capabilities"
          },
          "rules": {
            "type": "string",
            "maxLength": 100000,
            "title": "Rules",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "owner_name"
        ],
        "title": "ProjectCreate"
      },
      "Role": {
        "type": "string",
        "enum": [
          "owner",
          "coordinator",
          "worker",
          "observer"
        ],
        "title": "Role"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
