TEAM_SYNC_DATABASE_URL=postgresql+psycopg://team_sync:team_sync@localhost:5432/team_sync
TEAM_SYNC_BOOTSTRAP_TOKEN=replace-with-a-long-random-token
TEAM_SYNC_DB_PASSWORD=replace-with-a-long-hex-password
# Host port published by docker compose (loopback only).
TEAM_SYNC_HOST_PORT=8000
TEAM_SYNC_ARTIFACT_DIR=./data/artifacts
# For the stdio MCP bridge; use the project-scoped credential returned by the API.
TEAM_SYNC_URL=http://localhost:8000
TEAM_SYNC_PROJECT_ID=
TEAM_SYNC_TOKEN=
# MCP identity: auto (default) gives every MCP process its own agent identity when the
# access file belongs to a human or is already used by another process; direct uses it as is.
# TEAM_SYNC_IDENTITY=auto
# Where pooled agent identities and process locks live (default ~/.local/state/team-sync).
# TEAM_SYNC_STATE_DIR=
